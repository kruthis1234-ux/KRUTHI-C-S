# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN_PASSWORD: Optional server-side admin passcode for /admin when using built-in server persistence.
# Leave blank on first run to claim your admin password securely inside the /admin UI.
ADMIN_PASSWORD=

# SUPABASE CONFIGURATION (Recommended for permanent cloud database, auth & file storage)
# Create a free project at https://supabase.com and run supabase/schema.sql in the SQL Editor.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
